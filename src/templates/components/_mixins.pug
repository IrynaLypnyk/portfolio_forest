//- nav-links (burger-menu)
mixin nav-links_burger(pages)
  ul.nav__list_burger
    each page in pages
      li.nav__item_burger
        a.nav__link_burger(href=`${page[1]}`)= `${page[0]}`

//- nav-links (footer)
mixin nav-links(pages)
  nav.nav
    ul.nav__list
      each page in pages
        li.nav__item
          a.nav__link(href=`${page[1]}`)= `${page[0]}`

//- nav-btns to pages
mixin nav-btns (pages)
  ul.nav-btns
    each page in pages
      li.nav-btns__item
        a(href=`${page[1]}` class='nav-btns__link ' + 'nav-btns__link_' + `${page[2]}`)= `${page[0]}`


//- user (кроме страницы "Blog")
mixin user
  if className === 'welcome'
    +user-img
  .block-title.block-title_blog Iryna Lypnyk
  .user__title My first web portfolio · 2017


//- user-image
mixin user-img
  .user__img-block
    img(src="assets/images/content/iryna-lypnyk.jpg" alt="Iryna Lypnyk").user__img

//- socials
mixin socials (className, items)
  ul(class=`${className}__list`)
    each item in items
      li(class=`${className}__item`)
        - const social = item === 'github' ? { name: 'GitHub', url: 'https://github.com/IrynaLypnyk' } : { name: 'LinkedIn', url: 'https://www.linkedin.com/in/irynalypnyk/' }
        a(class=`${className}__link` href=social.url aria-label=social.name target="_blank" rel="noopener noreferrer")
          svg(class=`${className}__icon` + ` ${className}__icon_${item}` width="26px" height="26px")
            use(xlink:href="assets/images/icons/sprite.svg#"+ `${item}`)


//- header
mixin header (classMixin, svgImg, svgWidth, svgHeight)
  header(class='header ' + `header_${classMixin}` + ' section')
    div(class="header__links " + `header__links_${classMixin}`)
      .header__socials.socials
        +socials('socials', ["github", "in"])
      .header__burger-menu
        include ../components/_burger-menu.pug
    if classMixin !== 'blog'
      div(class='header__user-block ' + `header__user-block_${classMixin}`)
        div(class='user ' + `user_${classMixin}`)
          +user
        svg(class='user-info__bg-icon ' + `user-info__bg-icon_${classMixin}` width=`${svgWidth}` height=`${svgHeight}`)
          use(xlink:href="assets/images/icons/sprite.svg#" + `${svgImg}` + "_header")

      button.header__arrow-btn
        a.arrow__link(href="#")
          svg.arrow__icon(width="27" height="19")
            use(xlink:href="assets/images/icons/sprite.svg#arrow_down")
    else
      div(class='header__user-block ' + `header__user-block_${classMixin}`)
        div(class='user ' + `user_${classMixin}`)
          if className === 'welcome'
            +user-img
        svg(class='user-info__bg-icon ' + `user-info__bg-icon_${classMixin}` width=`${svgWidth}` height=`${svgHeight}`)
          use(xlink:href="assets/images/icons/sprite.svg#" + `${svgImg}` + "_header")
        div(class='block-title ' + `block-title_${classMixin}`) Blog
        .user__title Notes from the original learning project
      button.header__arrow-btn.header__arrow-btn_blog
        a.arrow__link(href="#")
          svg.arrow__icon(width="27" height="19")
            use(xlink:href="assets/images/icons/sprite.svg#arrow_down")



//- skills circles-row
mixin skills-circles (skills)
  ul.skills-row__list
    each skill in skills
      li.skills-row__item
        .skill-circle
          svg(viewBox="0 0 120 120").skill-circle__svg-img
            circle(r="50" cx="50%" cy="50%").circle.circle_base
            circle(r="50" cx="50%" cy="50%" class='circle' + ' circle_fill ' + `circle-${skill[1]}`).circle_second
          span.skill-circle__title= `${skill[0]}`


// - nav-items in blog
mixin blog-nav-items
  .blog-nav
    ul.blog-nav__list
      li.blog-nav__items
        a.blog-nav__links(href="#") Sass essentials
      li.blog-nav__items
        a.blog-nav__links(href="#") Everyday layout techniques
      li.blog-nav__items
        a.blog-nav__links(href="#") The original Gulp workflow
      li.blog-nav__items
        a.blog-nav__links(href="#") Templates with Jade and Pug


//- contacts
mixin contacts(classMixin, contactTypes)
  ul(class='contacts ' + `contacts_${classMixin}`)
    each contactType in contactTypes
      if classMixin == 'map'
        li(class='contacts__item ' + `contacts__item_${classMixin}`)
          svg(class=`contacts__icon ` + `contacts__icon_${contactType[0]}` width="26" height="26" )
            use(xlink:href="assets/images/icons/sprite.svg#" + `${contactType[0]}`)
          //- div(class='contacts__data')= `${contactType[1]}`
          a(href=`${contactType[2]}` class="contacts__link")= `${contactType[1]}`
      else
        li(class='contacts__item ' + `contacts__item_${classMixin}`)
          div(class='contacts__data')= `${contactType[1]}`

mixin footer(page)
  div(class='footer '+ 'footer_'+`${page}`)
    .footer__top
      .footer__col.footer__col_left
        .footer__copyright-block Built as my final project for the Loftschool web development course.
      .footer__col.footer__col_center
        .footer__nav-block
          +nav-links([['My work', 'my-works.html'], ['About me', 'about.html'], ['Blog', 'blog.html'], ['Login', 'index.html']])
        .footer__socials-block
          +socials('socials', ["github", "in"])
      .footer__col.footer__col_right
        .footer__cite-block
          blockquote.footer__cite-text Always code as if the guy who ends up maintaining your code will be a violent psychopath who knows where you live.
          cite.footer__cite-author — Martin Golding
    .footer__bottom
      .copyright
        p.copyright__item
          | &copy; 
          a.copyright__link(href="https://irynalypnyk.com") Iryna Lypnyk
        p.copyright__item Made with &#10084; at Loftschool | 2017

