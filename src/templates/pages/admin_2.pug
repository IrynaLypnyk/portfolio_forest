extends ../template_admin

block title
    title Admin demo - Blog

block admin__content
    .content-tab
        h2.content-tab__title Page "Blog"
        form.content-tab2__addArticle(action="")
            .name.content-tab2__name Add a post
            input(type="text" placeholder="Title" name="").content-tab2__name.admin-input
            input(type="text" placeholder="Date" name="").content-tab2__data.admin-input
            textarea(placeholder="Content" name='').content-tab2__text.admin-input
            .content-tab2__button
                button(type='submit').btn-admin.btn-admin--add Add
