extends ../template

block variables
  - var title = 'About me', className = 'about'

block content
  +header('about', 'portfolio', '1170', '285')
  section.section.section_about
    .triangles
      svg.triangles__svg(xmlns="http://www.w3.org/2000/svg" viewbox="0 0 1800 163" preserveaspectratio="none")
        polygon(points="0,0 0,163 901,163 901,160").triangles__svg_about-left
        polygon(points="1800,0 1800,163 899,163 899,160").triangles__svg_about-right
    .about__content-container
      .about__col.about__col_left
        .about__leftcol-title
          .block-title.block-title_about About me
          svg.block-title__bg-svg.block-title__bg-svg_about(viewBox="0 0 361 126")
            use(xlink:href="assets/images/icons/sprite.svg#about_header")
        .about__leftcol-content
          .user-description
            .user-description__image-block
              img.user-description__img(src="assets/images/content/iryna-illustrated.png" alt="Illustrated portrait of Iryna Lypnyk")
            .user-description__title
              .block-subtitle Who I am
            .user-description__text
              p I am Iryna Lypnyk, a web developer. I enjoy building websites and applications with thoughtful interfaces and responsive layouts.
              p I created this portfolio during the Loftschool web development course in 2017. It preserves the original forest design and learning exercises, with an updated build setup.
      .about__col.about__col_right
        .about__right-title
          .block-subtitle
            | What I
            br
            | work with
        .about__right-text
          p This project explores frontend development, from responsive layouts to JavaScript interactions. The skill charts below reflect the original course project.
        #skills.about__right-skills-block
          ul.skills
            li.skills__item
              .skills-row
                .skills-row__title Frontend
                +skills-circles([['HTML5', '90'], ['CSS3', '90'], ['JavaScript & jQuery','60']])
            li.skills__item
              .skills-row
                .skills-row__title Backend
                +skills-circles([['Node.js & npm', '20'], ['PHP', '15'], ['mySQL', '20'], ['Mongo.db','10']])
            li.skills__item
              .skills-row
                .skills-row__title Workflow
                +skills-circles([['Git', '80'], ['Gulp', '75'], ['Webpack', '50'], ['Sass & Pug(Jade)','90']])
  section.section.section_map
    #map
    .map-contacts
      .map-contacts__title
        .block-subtitle Contact
      .map-contacts__list
        +contacts('map', [['skype', 'skype_iryna.lypnyk', 'skype:iryna.lypnyk '], ['email', 'iryna.lypnyk@gmail.com', 'mailto:iryna.lypnyk@gmail.com'], ['phone', '+38 (063) 76 989 77', 'tel:+380637698977'], ['address', 'Kyiv, Ukraine', 'https://www.google.com/maps?q=50.4561854,30.5434603']])
  +footer('about')
block add-scripts
  if googleMapsApiKey
    script(src='https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(googleMapsApiKey) type="text/javascript" defer)
